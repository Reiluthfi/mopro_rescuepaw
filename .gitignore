# =============================================================
# IDE related
# =============================================================
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: share only the team-agreed config, ignore personal settings
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json

# =============================================================
# Flutter / Dart / Pub related
# =============================================================
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/

# FVM (Flutter Version Management): ignore the SDK symlink, keep the config
.fvm/flutter_sdk
# Commit .fvm/fvm_config.json and .fvmrc so everyone uses the same version

# NOTE: pubspec.lock is intentionally NOT ignored (this is an app, not a package)

# =============================================================
# Generated code (build_runner: freezed, json_serializable, etc.)
# =============================================================
# Uncomment ONLY if your team decides to regenerate these in CI
# instead of committing them. Decide once and stay consistent.
# *.g.dart
# *.freezed.dart
# *.mocks.dart
# *.gr.dart

# =============================================================
# Symbolication / Obfuscation
# =============================================================
app.*.symbols
app.*.map.json

# =============================================================
# Secrets and environment files (NEVER COMMIT)
# =============================================================
.env
.env.*
!.env.example
*.env
secrets.json
secrets.dart
**/lib/**/secrets.dart
api_keys.dart
config/secrets.*

